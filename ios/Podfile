# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

# Fix for v5.x Permissions
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native-permissions/scripts/setup.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, min_ios_version_supported
prepare_react_native_project!

# 1. Enable static frameworks globally (Required for Firebase Swift)
use_frameworks! :linkage => :static
use_modular_headers!

# Fix for v5.x Permissions
setup_permissions([
  'LocationWhenInUse',
  'LocationAlways',
  'Notifications',
  'Camera'
])

# --- THE CRITICAL FIX FOR NON-MODULAR HEADERS ---
# This hook intercepts pods before they compile and explicitly allows React Native's 
# core to coexist alongside Firebase's strict framework requirements.
pre_install do |installer|
  installer.pod_targets.each do |target|
    if target.name.start_with?('React') || target.name.start_with?('yoga')
      target.instance_variable_set(:@defines_module, true)
    end
  end
end

target 'safehuntApp' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  # React Native Vector Icons explicitly defined path
  pod 'RNVectorIcons', :path => '../node_modules/react-native-vector-icons'
  
  # React Native Maps dependencies
  rn_maps_path = '../node_modules/react-native-maps'
  pod 'react-native-maps/Google', :path => rn_maps_path

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
    )
    
    # Additional compiler flag security blanket for the "Non-modular header" error
    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |config|
        config.build_settings['CLANG_ALLOW_NON_MODULAR_INCLUDES_IN_FRAMEWORK_MODULES'] = 'YES'
        
        # --- ENHANCED FIX FOR FIREBASE MESSAGING V24 MODULE IMPORT ERROR ---
        if target.name == 'RNFBMessaging'
          config.build_settings['OTHER_CFLAGS'] ||= '$(inherited) -DRNFB_DYNAMIC_FRAMEWORKS=1'
          
          # Force Xcode to look inside RNFBApp headers to satisfy RCTPromiseRejectBlock
          config.build_settings['HEADER_SEARCH_PATHS'] ||= '$(inherited) '
          config.build_settings['HEADER_SEARCH_PATHS'] << '"$(PODS_ROOT)/Headers/Public/RNFBApp" '
          config.build_settings['HEADER_SEARCH_PATHS'] << '"$(PODS_TARGET_SRCROOT)/../RNFBApp" '
        end
      end
    end
  end
end